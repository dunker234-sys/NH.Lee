# NCP VM의 /opt/attendance/.env 로 복사해 채운다. 이 파일(.env)은 서버에만 두고
# 절대 커밋하지 않는다. 비밀번호는 URL에 들어가므로 반드시 hex로 만든다:
#   openssl rand -hex 24      (비밀번호류)
#   openssl rand -base64 32   (JWT 2종, 서로 다른 값)
#   openssl rand -hex 32      (암호화 키 2종, 64자리 hex, 서로 다른 값)

# 접속 도메인(예: example.com) → api.example.com / admin.example.com / kiosk.example.com
DOMAIN=

# deploy 스크립트(CI)가 배포 시 자동으로 덮어쓴다 — 수동으로 채우지 않는다.
IMAGE_REPO=ghcr.io/dunker234-sys
IMAGE_TAG=latest

POSTGRES_PASSWORD=
APP_RW_PASSWORD=
MIGRATOR_PASSWORD=
RETENTION_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_TOTP_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
