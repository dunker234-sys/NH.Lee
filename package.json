{
  "name": "attendance-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prisma:generate": "pnpm --filter @attendance/api exec prisma generate",
    "prisma:migrate": "pnpm --filter @attendance/api exec prisma migrate dev",
    "prisma:seed": "pnpm --filter @attendance/api exec prisma db seed",
    "build:packages": "pnpm --filter @attendance/shared-types build",
    "test:api": "pnpm build:packages && pnpm --filter @attendance/api test",
    "test:api:e2e": "pnpm build:packages && pnpm --filter @attendance/api test:e2e"
  }
}
