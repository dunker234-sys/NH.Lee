# 로컬 개발용. 실제 값은 .env(gitignore 대상)에 둔다.
DATABASE_URL="postgresql://app_rw:app_rw_dev_password@localhost:5432/attendance?schema=public"

# migrator 롤은 스키마 변경(마이그레이션) 전용. 애플리케이션 런타임에서 사용하지 않는다.
MIGRATOR_DATABASE_URL="postgresql://migrator:migrator_dev_password@localhost:5432/attendance?schema=public"

# 통합 테스트용 별도 DB (STEP 2 test/setup/global-setup.ts가 생성)
TEST_DATABASE_URL="postgresql://migrator:migrator_dev_password@localhost:5432/attendance_test?schema=public"

# --- STEP 2: 인증 ---
# 서로 다른 시크릿을 쓴다 — 액세스 서명 키 유출이 리프레시 위조로 번지지 않게 한다.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="14d"

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=10

PORT=3000
